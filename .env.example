# Copy to .env. Never commit .env. Placeholders only: no LAN addresses, no real values.
# Godot 4.7 mono binary (used by tests/run_all.sh and commands in CLAUDE.md)
GODOT=/path/to/Godot_mono.app/Contents/MacOS/Godot
# Apple Developer team (also set in export_presets.cfg and the Xcode project)
APPLE_TEAM_ID=XXXXXXXXXX
# Parent folder of sibling repos (Distribution golden workflows)
DEV_ROOT=~/Dev
